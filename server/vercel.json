{
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "eng.traineddata",
          "wasm/*"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/api/cron/(.*)",
      "dest": "api/index.ts"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/index.ts"
    },
    {
      "src": "/iclock/(.*)",
      "dest": "api/index.ts"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/absenteeism",
      "schedule": "0 18 * * *"
    }
  ]
}
