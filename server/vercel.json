{
  "version": 2,
  "builds": [
    {
      "src": "src/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/iclock/(.*)",
      "dest": "src/index.ts"
    },
    {
      "src": "/api/(.*)",
      "dest": "src/index.ts"
    },
    {
      "src": "/(.*)",
      "dest": "src/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/absenteeism",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/auto-close",
      "schedule": "10 18 * * *"
    },
    {
      "path": "/api/cron/machine-report",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/cron/maintenance",
      "schedule": "0 3 * * *"
    }
  ]
}
