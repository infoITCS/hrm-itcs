{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/attendance/adms/(.*)",
      "destination": "/api"
    },
    {
      "source": "/iclock/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/absenteeism",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/auto-close",
      "schedule": "10 18 * * *"
    },
    {
      "path": "/api/cron/machine-report",
      "schedule": "30 18 * * *"
    },
    {
      "path": "/api/cron/maintenance",
      "schedule": "0 3 * * *"
    }
  ]
}
