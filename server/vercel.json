{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": [
        "node_modules/tesseract.js-core/*.wasm",
        "eng.traineddata"
      ]
    }
  },
  "routes": [
    {
      "src": "/api/cron/(.*)",
      "dest": "api/index.ts"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/index.ts"
    },
    {
      "src": "/iclock/(.*)",
      "dest": "api/index.ts"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/absenteeism",
      "schedule": "0 18 * * *"
    }
  ]
}
